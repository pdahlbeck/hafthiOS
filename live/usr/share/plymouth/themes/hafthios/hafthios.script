# Keep the supplied artwork intact; animate its position, not its proportions.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
ship.original = Image("ship.png");
ship.width = Math.Min(Window.GetWidth() * 0.90, Window.GetHeight() * 1.15);
ship.width = Math.Min(ship.width, ship.original.GetWidth());
ship.image = ship.original.Scale(ship.width, ship.width * ship.original.GetHeight() / ship.original.GetWidth());
ship.sprite = Sprite(ship.image);
ship.phase = 0;

hint.image = Image.Text("Esc - Show boot details", 0.55, 0.55, 0.55);
hint.sprite = Sprite(hint.image);
hint.sprite.SetPosition(Window.GetX() + (Window.GetWidth() - hint.image.GetWidth()) / 2,
                        Window.GetY() + Window.GetHeight() * 0.90, 10);

fun refresh ()
{
    global.ship.phase += 0.025;
    ship.sprite.SetPosition(Window.GetX() + (Window.GetWidth() - ship.image.GetWidth()) / 2 + Math.Sin(ship.phase * 0.45) * 22,
                            Window.GetY() + (Window.GetHeight() - ship.image.GetHeight()) / 2 + Math.Sin(ship.phase) * 5, 0);
}
Plymouth.SetRefreshFunction(refresh);
