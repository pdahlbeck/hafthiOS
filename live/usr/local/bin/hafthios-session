#!/usr/bin/env bash
set -euo pipefail
export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
export GDK_BACKEND=wayland GTK_THEME=Adwaita:dark GSK_RENDERER=cairo
if [[ -w /dev/ttyS0 ]]; then exec > /dev/ttyS0 2>&1; fi
# Cage owns the welcome only. Its CPU renderer is not inherited by Niri.
WLR_RENDERER=pixman cage -- /usr/local/bin/hafthios-welcome
if [[ -f "$XDG_RUNTIME_DIR/hafthios-try-desktop" ]]; then
    rm -f "$XDG_RUNTIME_DIR/hafthios-try-desktop"
    niri-session || {
        journalctl --user -u niri.service --no-pager -n 100
        exit 1
    }
fi
