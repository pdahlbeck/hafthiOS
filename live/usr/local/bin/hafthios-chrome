#!/usr/bin/env python3
"""Download official Google Chrome on first use; keep its sandbox enabled."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import threading
import urllib.request

URL = 'https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb'
ROOT = Path.home() / '.local/share/hafthios/google-chrome'
BINARY = ROOT / 'opt/google/chrome/chrome'


def install():
    # Download and extraction occur in the user's disposable live home.
    ROOT.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(dir=ROOT.parent) as temporary:
        work = Path(temporary)
        with urllib.request.urlopen(URL, timeout=60) as response, (work / 'chrome.deb').open('wb') as output:
            shutil.copyfileobj(response, output)
        subprocess.run(['bsdtar', '-xf', str(work / 'chrome.deb'), '-C', str(work)], check=True)
        archive = next(work.glob('data.tar.*'))
        extracted = work / 'extracted'
        extracted.mkdir()
        subprocess.run(['bsdtar', '-xf', str(archive), '-C', str(extracted)], check=True)
        if not (extracted / 'opt/google/chrome/chrome').is_file():
            raise RuntimeError('Google Chrome was not found in the downloaded package.')
        if ROOT.exists():
            shutil.rmtree(ROOT)
        extracted.rename(ROOT)


def launch():
    if os.geteuid() == 0:
        raise RuntimeError('Open Chrome from the hafthi live user, not root.')
    subprocess.Popen([str(BINARY), '--ozone-platform=wayland', '--no-first-run',
                      '--no-default-browser-check',
                      '--user-data-dir=' + str(Path.home() / '.config/hafthios/chrome')],
                     cwd=BINARY.parent)


def main():
    if BINARY.exists():
        launch()
        return
    import gi
    gi.require_version('Gtk', '4.0')
    from gi.repository import Gtk, GLib
    app = Gtk.Application(application_id='org.hafthios.ChromeSetup')
    def activate(app):
        window = Gtk.ApplicationWindow(application=app, title='Google Chrome')
        window.set_default_size(480, 280)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        for side in ('top', 'bottom', 'start', 'end'):
            getattr(box, 'set_margin_' + side)(28)
        window.set_child(box)
        title = Gtk.Label(label='Google Chrome', xalign=0)
        title.add_css_class('title-1')
        box.append(title)
        status = Gtk.Label(label='Download Chrome directly from Google. An internet connection is required. It stays in this live session until you restart.', xalign=0)
        status.set_wrap(True)
        box.append(status)
        box.append(Gtk.LinkButton.new_with_label('https://www.google.com/chrome/terms/', 'Google Chrome terms'))
        button = Gtk.Button(label='Download and open Google Chrome')
        button.add_css_class('suggested-action')
        box.append(button)
        def finished(error):
            if error:
                status.set_text('Could not download or open Chrome: ' + error)
                button.set_sensitive(True)
            else:
                app.quit()
            return False
        def download(_):
            button.set_sensitive(False)
            status.set_text('Downloading Google Chrome… This can take a few minutes.')
            def worker():
                error = None
                try:
                    install()
                    launch()
                except Exception as exc:
                    error = str(exc)
                GLib.idle_add(finished, error)
            threading.Thread(target=worker, daemon=True).start()
        button.connect('clicked', download)
        window.set_default_widget(button)
        button.grab_focus()
        window.present()
    app.connect('activate', activate)
    app.run(None)

if __name__ == '__main__':
    main()
