#!/usr/bin/env python3
"""Quiet coastal greeter; authentication belongs exclusively to greetd/PAM."""
import json
import math
import os
from pathlib import Path
import socket
import struct
import threading
import time


class Client:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(30)
        self.sock.connect(path)

    def read(self, size):
        data = bytearray()
        while len(data) < size:
            chunk = self.sock.recv(size - len(data))
            if not chunk:
                raise ConnectionError('greetd closed its socket')
            data.extend(chunk)
        return bytes(data)

    def request(self, message):
        payload = json.dumps(message).encode('utf-8')
        self.sock.sendall(struct.pack('=I', len(payload)) + payload)
        size = struct.unpack('=I', self.read(4))[0]
        if size > 1024 * 1024:
            raise ValueError('Invalid greetd response size')
        return json.loads(self.read(size))

    def close(self):
        self.sock.close()


def draw_coast(ctx, width, height, elapsed, ship, cairo):
    """Resolution-independent line art, with no movie or network assets."""
    ctx.save()
    ctx.scale(width / 1440, height / 900)
    gradient = cairo.LinearGradient(0, 0, 1440, 900)
    gradient.add_color_stop_rgb(0, .055, .080, .100)
    gradient.add_color_stop_rgb(1, .100, .155, .175)
    ctx.set_source(gradient)
    ctx.paint()
    ctx.set_source_rgba(.66, .77, .77, .10)
    ctx.set_line_width(1)
    ctx.move_to(0, 535)
    ctx.curve_to(480, 532, 950, 537, 1440, 532)
    ctx.stroke()
    ctx.move_to(1440, 620)
    ctx.curve_to(1170, 612, 1200, 742, 870, 900)
    ctx.line_to(1440, 900)
    ctx.close_path()
    ctx.set_source_rgba(.27, .32, .31, .25)
    ctx.fill_preserve()
    ctx.set_source_rgba(.69, .76, .70, .32)
    ctx.set_line_width(1.4)
    ctx.stroke()
    for index in range(7):
        phase = (elapsed / 18 + index / 7) % 1
        y = 566 + phase * 338
        end = 1350 - (y - 560) * 1.05
        ctx.set_source_rgba(.69, .82, .82, .16 * math.sin(math.pi * phase) ** 2)
        ctx.set_line_width(1.2)
        ctx.move_to(0, y + 9)
        ctx.curve_to(end * .32, y - 10, end * .68, y + 14, end, y)
        ctx.stroke()
    if ship is not None:
        ctx.save()
        ctx.translate(1010, 547 + math.sin(elapsed / 5) * 1.3)
        ctx.scale(170 / ship.get_width(), 170 / ship.get_width())
        ctx.set_operator(cairo.OPERATOR_SCREEN)
        ctx.set_source_surface(ship, 0, 0)
        ctx.paint_with_alpha(.67)
        ctx.restore()
    ctx.set_source_rgba(.78, .83, .80, .42)
    ctx.set_line_width(1.3)
    for x, y, size in ((1130, 355, 12), (1163, 343, 8)):
        ctx.move_to(x - size, y + 2)
        ctx.curve_to(x - size / 2, y - 4, x - 2, y - 3, x, y + 2)
        ctx.curve_to(x + 2, y - 3, x + size / 2, y - 4, x + size, y + 2)
        ctx.stroke()
    ctx.restore()


def main():
    import gi
    gi.require_version('Gtk', '3.0')
    gi.require_version('Gdk', '3.0')
    gi.require_foreign('cairo')
    import cairo
    from gi.repository import Gdk, GLib, Gtk

    preview = os.sys.argv[1:] == ['--preview']
    if not preview and not os.environ.get('GREETD_SOCK'):
        raise SystemExit('Start through greetd; use --preview for visual review.')
    swedish = os.environ.get('LANG', '').startswith('sv')
    def tr(en, sv):
        return sv if swedish else en

    class Greeter(Gtk.Window):
        def __init__(self):
            super().__init__(title='Hafþi — welcome home')
            self.client, self.stage, self.busy = None, 'username', False
            self.moving, self.started = True, time.monotonic()
            self.connect('destroy', Gtk.main_quit)
            self.connect('key-press-event', self.key)
            if preview:
                self.set_default_size(1440, 900)
            self.fullscreen()
            settings = Gtk.Settings.get_default()
            settings.set_property('gtk-cursor-theme-name', 'Adwaita')
            settings.set_property('gtk-cursor-theme-size', 24)
            css = Gtk.CssProvider()
            css.load_from_path(str(Path(__file__).parents[3] / 'etc/greetd/hafthios.css') if preview else '/etc/greetd/hafthios.css')
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            overlay = Gtk.Overlay()
            self.add(overlay)
            self.canvas = Gtk.DrawingArea()
            overlay.add(self.canvas)
            path = Path(__file__).parents[2] / 'share/plymouth/themes/hafthios/ship.png' if preview else Path('/usr/share/plymouth/themes/hafthios/ship.png')
            original = cairo.ImageSurface.create_from_png(str(path))
            self.ship = cairo.ImageSurface(cairo.FORMAT_ARGB32, original.get_width(), original.get_height())
            image_context = cairo.Context(self.ship)
            image_context.set_source_surface(original, 0, 0)
            image_context.paint()
            # Remove the raster's dark paper once, leaving the original strokes.
            self.ship.flush()
            pixels = self.ship.get_data()
            for offset in range(0, len(pixels), 4):
                alpha = max(0, min(255, (max(pixels[offset:offset + 3]) - 100) * 255 // 155))
                pixels[offset:offset + 4] = bytes((alpha, alpha, alpha, alpha))
            self.ship.mark_dirty()
            self.canvas.connect('draw', self.draw)
            self.canvas.connect('size-allocate', self.resize)
            self.form = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
            self.form.set_name('login')
            self.form.set_halign(Gtk.Align.CENTER)
            self.form.set_valign(Gtk.Align.CENTER)
            self.form.set_size_request(320, -1)
            overlay.add_overlay(self.form)
            for text, name in [('Hafþi', 'brand'), (tr('Welcome home.', 'Välkommen hem.'), 'subtitle')]:
                label = Gtk.Label(label=text)
                label.set_name(name)
                label.set_xalign(0)
                self.form.pack_start(label, False, False, 0)
            self.prompt = Gtk.Label(label=tr('Username', 'Användarnamn'))
            self.prompt.set_xalign(0)
            self.form.pack_start(self.prompt, False, False, 0)
            self.entry = Gtk.Entry()
            self.entry.set_max_length(512)
            self.entry.connect('activate', self.submit)
            self.form.pack_start(self.entry, False, False, 0)
            self.button = Gtk.Button(label=tr('Continue', 'Fortsätt'))
            self.button.connect('clicked', self.submit)
            self.form.pack_start(self.button, False, False, 0)
            self.message = Gtk.Label()
            self.message.set_name('message')
            self.message.set_line_wrap(True)
            self.message.set_max_width_chars(36)
            self.message.set_xalign(0)
            self.form.pack_start(self.message, False, False, 0)
            self.motion = Gtk.Button(label=tr('Pause waves', 'Pausa vågorna'))
            self.motion.set_name('motion')
            self.motion.set_halign(Gtk.Align.START)
            self.motion.set_valign(Gtk.Align.END)
            self.motion.set_margin_start(32)
            self.motion.set_margin_bottom(24)
            self.motion.connect('clicked', self.toggle_motion)
            overlay.add_overlay(self.motion)
            GLib.timeout_add(67, self.tick)
            self.show_all()
            self.entry.grab_focus()

        def resize(self, _canvas, allocation):
            self.form.set_margin_end(int(allocation.width * .30) if allocation.width >= 1000 else 0)

        def draw(self, canvas, ctx):
            elapsed = time.monotonic() - self.started if self.moving else 0
            draw_coast(ctx, canvas.get_allocated_width(), canvas.get_allocated_height(), elapsed, self.ship, cairo)

        def tick(self):
            if self.moving and self.canvas.get_mapped():
                self.canvas.queue_draw()
            return True

        def toggle_motion(self, *_):
            self.moving = not self.moving
            self.motion.set_label(tr('Pause waves', 'Pausa vågorna') if self.moving else tr('Animate waves', 'Animera vågorna'))
            self.canvas.queue_draw()

        def key(self, _window, event):
            if event.keyval == Gdk.KEY_F10:
                self.toggle_motion()
                return True
            if event.keyval == Gdk.KEY_Escape and not self.busy and self.stage != 'username':
                self.send({'type': 'cancel_session'}, cancel=True)
                return True
            return False

        def submit(self, *_):
            if self.busy:
                return
            value = self.entry.get_text()
            self.entry.set_text('')
            if self.stage == 'username':
                if value.strip():
                    self.send({'type': 'create_session', 'username': value.strip()})
            else:
                self.send({'type': 'post_auth_message_response', 'response': value})

        def send(self, request, cancel=False, starting=False):
            self.busy = True
            self.entry.set_sensitive(False)
            self.button.set_sensitive(False)
            def worker():
                try:
                    if preview:
                        reply = {'type': 'auth_message', 'auth_message_type': 'secret', 'auth_message': 'Password:'}
                    else:
                        if self.client is None:
                            self.client = Client(os.environ['GREETD_SOCK'])
                        reply = self.client.request(request)
                        if reply.get('type') == 'error':
                            self.client.request({'type': 'cancel_session'})
                    GLib.idle_add(self.response, reply, cancel, starting)
                except (OSError, ValueError, KeyError):
                    if self.client:
                        self.client.close()
                        self.client = None
                    GLib.idle_add(self.response, {'type': 'error'}, False, False)
            threading.Thread(target=worker, daemon=True).start()

        def reset(self):
            self.stage = 'username'
            self.entry.set_visibility(True)
            self.entry.set_input_purpose(Gtk.InputPurpose.FREE_FORM)
            self.prompt.set_text(tr('Username', 'Användarnamn'))
            self.button.set_label(tr('Continue', 'Fortsätt'))

        def response(self, reply, cancel, starting):
            self.busy = False
            self.entry.set_sensitive(True)
            self.button.set_sensitive(True)
            kind = reply.get('type')
            if cancel:
                self.reset()
                self.message.set_text('')
            elif kind == 'success':
                if starting:
                    self.destroy()
                    return False
                self.send({'type': 'start_session', 'cmd': ['/usr/local/bin/hafthios-installed-session'],
                           'env': ['XDG_SESSION_TYPE=wayland']}, starting=True)
                return False
            elif kind == 'auth_message':
                auth_kind = reply.get('auth_message_type')
                if auth_kind in ('info', 'error'):
                    self.message.set_text(reply.get('auth_message', ''))
                    self.send({'type': 'post_auth_message_response'})
                    return False
                if auth_kind not in ('visible', 'secret'):
                    self.send({'type': 'cancel_session'}, cancel=True)
                    return False
                self.stage = 'answer'
                secret = auth_kind == 'secret'
                self.entry.set_visibility(not secret)
                self.entry.set_input_purpose(Gtk.InputPurpose.PASSWORD if secret else Gtk.InputPurpose.FREE_FORM)
                prompt = reply.get('auth_message', '')
                self.prompt.set_text(tr('Password', 'Lösenord') if secret and prompt.lower().strip(': ') == 'password' else prompt)
                self.button.set_label(tr('Log in', 'Logga in'))
                self.message.set_text('')
            else:
                self.reset()
                self.message.set_text(tr('Login failed. Please try again.', 'Inloggning misslyckades. Försök igen.'))
            self.entry.grab_focus()
            return False

    Greeter()
    Gtk.main()


if __name__ == '__main__':
    main()
