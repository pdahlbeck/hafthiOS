#!/usr/bin/env python3
"""A quiet coastal village, independently verified and updated behind the desktop windows."""
import argparse
import json
from functools import lru_cache
import heapq
import math
import os
from pathlib import Path
import random
import sys
import time

DEFAULT = {'enabled': True, 'paused': False, 'economy': False, 'responsive': True}


def preferences(home=None):
    try:
        value = json.loads(((home or Path.home()) / '.config/hafthios/world.json').read_text())
        return {key: value.get(key) if type(value.get(key)) is bool else default
                for key, default in DEFAULT.items()}
    except (OSError, ValueError, AttributeError):
        return DEFAULT.copy()


def save_preferences(value, home=None):
    import runpy
    if set(value) != set(DEFAULT) or any(type(v) is not bool for v in value.values()):
        raise ValueError('Invalid village preferences')
    backend = runpy.run_path(str(Path(__file__).with_name('hafthios-settings')))
    backend['atomic_write']((home or Path.home()) / '.config/hafthios/world.json', json.dumps(value) + '\n')


class Telemetry:
    """Read aggregate counters only. Missing VM sensors remain unknown."""
    def __init__(self, proc=Path('/proc'), system=Path('/sys')):
        self.proc, self.system = proc, system
        self.previous_cpu = self.previous_net = None
        self.load, self.network, self.temperature = .08, 0., None
        self.battery_low = False

    def sample(self, now):
        try:
            fields = (self.proc / 'stat').read_text().splitlines()[0].split()
            counters = [int(x) for x in fields[1:9]]  # Guest time is already in user/nice.
            total, idle = sum(counters), counters[3] + counters[4]
            if self.previous_cpu:
                delta = total - self.previous_cpu[0]
                if delta > 0:
                    busy = 1 - (idle - self.previous_cpu[1]) / delta
                    self.load += (max(0., min(1., busy)) - self.load) * .18
            self.previous_cpu = total, idle
        except (OSError, ValueError, IndexError):
            pass
        try:
            received = 0
            for line in (self.proc / 'net/dev').read_text().splitlines()[2:]:
                name, data = line.split(':', 1)
                if name.strip() != 'lo':
                    received += int(data.split()[0])
            if self.previous_net and now > self.previous_net[1]:
                rate = max(0, received - self.previous_net[0]) / (now - self.previous_net[1])
                self.network += (min(1., rate / 2_000_000) - self.network) * .20
            self.previous_net = received, now
        except (OSError, ValueError, IndexError):
            pass
        temperatures = []
        for hwmon in (self.system / 'class/hwmon').glob('hwmon*'):
            try:
                chip = (hwmon / 'name').read_text().strip().lower()
            except OSError:
                continue
            if chip not in ('coretemp', 'k10temp', 'zenpower', 'cpu_thermal'):
                continue
            for sensor in hwmon.glob('temp*_input'):
                try:
                    value = int(sensor.read_text()) / 1000
                    if 0 < value < 125:
                        temperatures.append(value)
                except (OSError, ValueError):
                    pass
        self.temperature = max(temperatures) if temperatures else None
        self.battery_low = False
        for supply in (self.system / 'class/power_supply').glob('*'):
            try:
                if (supply / 'type').read_text().strip() == 'Battery':
                    self.battery_low |= ((supply / 'status').read_text().strip() == 'Discharging'
                                         and int((supply / 'capacity').read_text()) <= 20)
            except (OSError, ValueError):
                pass


def frame_interval(prefs, metrics):
    if not prefs['enabled'] or prefs['paused']:
        return 1000
    if prefs['economy'] or metrics.battery_low:
        return 200
    return 125 if metrics.load > .75 else 83


# Scene units are shared: an adult is 22 high, a door 31 high,
# a longhouse about 270 long and a trading ship 210 long (visible ink).
WORLD_WIDTH, WORLD_HEIGHT = 2160, 1350
HOUSES = [(820,810,1.4,0),(1240,765,1.5,0),(1660,840,1.45,0),
          (900,960,1.3,240),(1840,970,1.4,1080),(1510,995,1.25,1800)]
DAY_LENGTH = 1800
SUPPER_X, SUPPER_Y = 960, 1015
COAST = [(-160,1040),(300,1060),(600,1100),(900,1070),(1200,1040),
         (1400,1040),(1700,1130),(1900,1180),(2320,1140)]


def shoreline_y(x):
    for (ax,ay),(bx,by) in zip(COAST,COAST[1:]):
        if ax<=x<=bx:
            return ay+(by-ay)*(x-ax)/(bx-ax)
    raise ValueError('Position outside landscape')


# Screen-space footprints include roofs, so paths never appear over a house.
HOUSE_OBSTACLES = [(x-99*size-8,y-71*size-8,x+130*size+8,y+12)
                   for x,y,size,_ in HOUSES]


def door_position(point):
    x,y=point
    for left,top,right,bottom in HOUSE_OBSTACLES:
        if left<x<right and top<y<bottom:
            return (x,bottom+1)
    return point


def clear_house_segment(a,b):
    for left,top,right,bottom in HOUSE_OBSTACLES:
        lo,hi=0.,1.
        for start,delta,minimum,maximum in ((a[0],b[0]-a[0],left,right),
                                          (a[1],b[1]-a[1],top,bottom)):
            if abs(delta)<1e-9:
                if not minimum<start<maximum:
                    hi=-1; break
            else:
                low,high=sorted(((minimum-start)/delta,(maximum-start)/delta))
                lo,hi=max(lo,low),min(hi,high)
        if lo<hi and hi>0 and lo<1:
            return False
    return True


@lru_cache(maxsize=512)
def walking_route(a,b):
    a,b=door_position(a),door_position(b)
    if clear_house_segment(a,b):
        return (a,b)
    nodes=[a,b]
    for left,top,right,bottom in HOUSE_OBSTACLES:
        nodes.extend([(left-1,top-1),(right+1,top-1),
                      (left-1,bottom+1),(right+1,bottom+1)])
    queue=[(0.,0,(0,))]; best={0:0.}
    while queue:
        distance,index,path=heapq.heappop(queue)
        if index==1:
            return tuple(nodes[i] for i in path)
        if distance>best[index]:
            continue
        for other,point in enumerate(nodes):
            if other==index or not clear_house_segment(nodes[index],point):
                continue
            cost=distance+math.dist(nodes[index],point)
            if cost<best.get(other,float('inf')):
                best[other]=cost
                heapq.heappush(queue,(cost,other,path+(other,)))
    raise ValueError('No safe path around village houses')


def route_position(points,fraction):
    lengths=[math.dist(a,b) for a,b in zip(points,points[1:])]
    distance=max(0,min(1,fraction))*sum(lengths)
    for a,b,length in zip(points,points[1:],lengths):
        if distance<=length:
            f=distance/length if length else 0
            return (a[0]+(b[0]-a[0])*f,a[1]+(b[1]-a[1])*f)
        distance-=length
    return points[-1]


def evening_light(t):
    """A slow dusk and dawn; the saved village clock also preserves its day."""
    phase=t%DAY_LENGTH
    return max(0, math.sin(math.pi*(phase-1050)/750)) if phase>1050 else 0


def daily_actors(t):
    """Shared food delivery and supper, then each villager walks home."""
    field, store, quay, kitchen, oven = (2040,875),(1618,837),(1397,1145),(1510,1018),(1570,1040)
    homes=[(775,810),(1192,765),(1614,840),(775,810),(1192,765),
           (1614,840),(775,810),(1192,765),(1614,840)]
    tasks=[[(130,field,'walk'),(350,field,'sow'),(450,field,'harvest'),
            (500,store,'sack'),(580,field,'walk'),(830,field,'harvest'),(900,store,'sack')],
           [(90,(1397,1020),'walk'),(130,quay,'walk'),(380,quay,'fish'),(400,(1397,1020),'fish-carry'),(440,kitchen,'fish-carry'),
            (560,kitchen,'clean-fish'),(600,(1397,1020),'walk'),(680,quay,'walk'),(850,quay,'fish'),(880,(1397,1020),'fish-carry'),(930,kitchen,'fish-carry')],
           [(140,kitchen,'walk'),(440,kitchen,'talk'),(590,kitchen,'cook'),
            (640,oven,'walk'),(890,oven,'bake'),(970,kitchen,'bread')],
           [(100,(1435,1025),'walk'),(400,(1435,1025),'net'),
            (460,(1460,1030),'walk'),(830,(1460,1030),'weave'),(950,(1435,1025),'net')],
           [(130,(1650,835),'walk'),(570,(1650,835),'roof'),
            (660,(1690,915),'walk'),(900,(1690,915),'sit')],
           [(160,(1790,1080),'walk'),(230,(1790,1080),'feed'),
            (350,(2010,1010),'herd'),(680,(2010,1010),'feed'),(800,(1790,1080),'herd'),
            (880,(1790,1080),'feed')],
           [(120,(1000,880),'walk'),(440,(1000,880),'talk'),
            (510,store,'walk'),(790,store,'handoff'),(930,(1000,880),'sit')],
           [(140,(1014,880),'walk'),(440,(1014,880),'talk'),
            (530,(1435,1025),'walk'),(840,(1435,1025),'net'),(920,(1014,880),'sit')],
           [(130,field,'walk'),(440,field,'sow'),(540,store,'sack'),
            (630,field,'walk'),(830,field,'harvest'),(920,store,'sack')]]
    actors=[]
    for i,(home,jobs) in enumerate(zip(homes,tasks)):
        seat=(SUPPER_X+(i%5)*17,SUPPER_Y+(i//5)*20)
        schedule=[(35,home,'indoors')]+jobs+[(985,(1550,1000),'walk'),
                    (1025,(seat[0],990),'walk'),(1050,seat,'walk'),(1230,seat,'eat'),
                    (1360,home,'walk'),(DAY_LENGTH,home,'indoors')]
        actors.append(scheduled_actor(t,DAY_LENGTH,schedule))
    return actors


def voyage_state(t):
    phase=t%360
    if phase < 60 or phase >= 300:
        return 0., True
    if phase < 150:
        f=(phase-60)/90
    elif phase < 210:
        f=1.
    else:
        f=1-(phase-210)/90
    return f*f*(3-2*f), False


def worker_state(t, index, home, destination, task):
    """A continuous home -> path -> task -> path -> indoor cycle."""
    home,destination=door_position(home),door_position(destination)
    points=walking_route(home,destination)
    distances=[math.dist(a,b) for a,b in zip(points,points[1:])]
    travel=sum(distances)/13  # Same walking speed for every occupation.
    work={'wood':60,'ship':80,'build':60,'smith':60,'hunt':40,'feed':30}.get(task,48)
    period=16+2*travel+work
    phase=(t+index*19)%period
    if phase < 8 or phase >= period-8:
        return {'visible':False,'position':home,'action':'indoors','phase':phase}
    elapsed=phase-8
    if elapsed < travel:
        action='walk'
        fraction=elapsed/travel
    elif elapsed < travel+work:
        return {'visible':True,'position':destination,'action':task,'phase':elapsed-travel}
    else:
        action='carry' if task in ('wood','load','feed','build','ship') else 'walk'
        fraction=1-(elapsed-travel-work)/travel
    distance=fraction*sum(distances)
    for segment,(a,b,length) in enumerate(zip(points,points[1:],distances)):
        if distance <= length or segment==len(distances)-1:
            f=min(1,distance/length) if length else 0
            return {'visible':True,'position':(a[0]+(b[0]-a[0])*f,a[1]+(b[1]-a[1])*f),
                    'action':action,'phase':elapsed}
        distance-=length
    return {'visible':True,'position':home,'action':action,'phase':elapsed}


def scheduled_actor(t, period, schedule):
    """Follow a shared village clock; adjoining segments meet at handoffs."""
    phase=t%period
    previous=schedule[-1][1]
    start=0
    for end,point,action in schedule:
        if phase < end:
            f=(phase-start)/(end-start)
            position=route_position(walking_route(previous,point),f)
            return {'visible':action not in ('indoors','aboard'), 'position':position,
                    'action':action, 'phase':phase-start}
        previous,start=point,end
    raise ValueError('Schedule does not cover the whole period')


def connected_actors(t):
    stump,forge,yard=(395,860),(1158,931),(590,1040)
    wood_home=(785,807)
    smith_home=(1202,762)
    supply=[
        scheduled_actor(t,480,[(60,stump,'wood'),(80,(610,938),'timber'),
                              (135,forge,'timber'),(143,forge,'handoff'),
                              (190,wood_home,'walk'),(430,wood_home,'indoors'),(480,stump,'walk')]),
        scheduled_actor(t,480,[(125,smith_home,'indoors'),(145,forge,'walk'),
                              (220,forge,'smith'),(245,smith_home,'walk'),(480,smith_home,'indoors')]),
        scheduled_actor(t,480,[(220,(1143,943),'talk'),(268,yard,'tools'),
                              (278,yard,'handoff'),(326,(1143,943),'walk'),(480,(1143,943),'talk')]),
        scheduled_actor(t,480,[(278,(650,1040),'talk'),(410,(650,1040),'ship'),
                              (480,(650,1040),'talk')])]
    # Arrival is voyage phase 300, followed by a 120-second mooring interval
    # across the clock wrap. The crew must board before phase 60 departure.
    boat,quay,gate,market=(1334,1170),(1370,1170),(1385,1045),(1280,1024)
    trade=[]
    for delay in (0,7):
        trade.append(scheduled_actor(t+60-delay,360,
            [(8,boat,'talk'),(12,quay,'walk'),(23,gate,'carry'),
             (36,market,'cart'),(55,market,'trade'),(70,gate,'cart'),
             (84,quay,'carry'),(95,boat,'walk'),(360,boat,'aboard')]))
    return supply+trade


def hunting_state(t):
    """Twenty measured shots per outing, one catch, then a walk home."""
    phase=t%360
    home=(785,823); stand=(360,840); prey=(540,835)
    if phase<40:
        position=route_position(walking_route(home,stand),phase/40)
        action='walk'; shot=None
    elif phase<280:
        position=stand; action='hunt'; shot=int((phase-40)//12)
    elif phase<320:
        position=route_position(walking_route(stand,prey),(phase-280)/40)
        action='walk'; shot=None
    else:
        position=route_position(walking_route(prey,home),(phase-320)/40)
        action='carry'; shot=None
    flight=(phase-40)%12 if shot is not None else None
    return {'visible':True,'position':position,'action':action,'phase':phase,
            'shot':shot,'flight':flight,'hit':shot==19,
            'caught':269.8<=phase<320,'prey':prey}


class Village:
    def __init__(self, cairo):
        self.cairo = cairo
        self.trees = [(random.Random(i).uniform(70, 620), random.Random(i + 80).uniform(740, 930),
                       random.Random(i + 160).uniform(30, 62)) for i in range(26)]
        self.trees += [(random.Random(900+i).uniform(1820,2150),
                        random.Random(980+i).uniform(735,795),
                        random.Random(1060+i).uniform(28,48)) for i in range(18)]
        path = Path(__file__).parents[2] / 'share/plymouth/themes/hafthios/ship.png'
        original = cairo.ImageSurface.create_from_png(str(path))
        self.ship = cairo.ImageSurface(cairo.FORMAT_ARGB32, original.get_width(), original.get_height())
        ctx = cairo.Context(self.ship)
        ctx.set_source_surface(original, 0, 0)
        ctx.paint()
        self.ship.flush()
        pixels = self.ship.get_data()
        bounds=[original.get_width(),original.get_height(),0,0]
        stride=self.ship.get_stride()
        for i in range(0, len(pixels), 4):
            alpha = max(0, min(255, (max(bytes(pixels[i:i + 3])) - 100) * 255 // 155))
            pixels[i:i + 4] = bytes((alpha, alpha, alpha, alpha))
            if alpha > 30:
                xx,yy=(i%stride)//4,i//stride
                bounds=[min(bounds[0],xx),min(bounds[1],yy),max(bounds[2],xx),max(bounds[3],yy)]
        self.ship.mark_dirty()
        self.ship_bounds=bounds
        self.ship_ink_width=bounds[2]-bounds[0]+1

    def line(self, ctx, points, alpha=.24, width=1.1, warm=False):
        ctx.set_source_rgba(*((.80, .67, .48) if warm else (.63, .76, .74)), alpha)
        ctx.set_line_width(width)
        ctx.move_to(*points[0])
        for point in points[1:]:
            ctx.line_to(*point)
        ctx.stroke()

    def house(self, c, x, y, size, progress, t, activity):
        # Long side view with a deep pitched roof and a small visible gable.
        w, h, pitch = 180 * size, 25 * size, 37 * size
        left, right = x - w / 2, x + w / 2
        wall = [(left,y), (left,y-h), (right,y-h-9*size),
                (right,y-9*size), (left,y)]
        roof = [(left-9*size,y-h+3*size), (left+22*size,y-h-pitch),
                (right+16*size,y-h-pitch-9*size),
                (right+40*size,y-h-6*size), (left-9*size,y-h+3*size)]
        ridge = roof[1:3]
        if progress < 1:
            for f in (0,.2,.4,.6,.8,1):
                xx=left+w*f
                self.line(c,[(xx,y-9*size*f),
                             (xx,y-9*size*f-h*min(1,progress*2))],.27)
            if progress > .45:
                self.line(c,roof,.12+.17*progress)
                self.line(c,[(left+22*size,y-h-pitch),(left+22*size,y)],.20)
            self.line(c,[(left-15*size,y+5*size),(left+20*size,y+8*size)],.28)
            return
        for points, color in [(wall,(.14,.20,.20,.80)),(roof,(.21,.25,.22,.78))]:
            c.move_to(*points[0])
            for point in points[1:]:
                c.line_to(*point)
            c.set_source_rgba(*color)
            c.fill()
            self.line(c,points,.37)
        self.line(c,ridge,.48,1.4)
        # Fine thatch strokes follow the roof slope, without bright patterning.
        for i in range(19):
            f=i/18
            self.line(c,[(left+22*size+(w-6*size)*f,y-h-pitch-9*size*f+3*size),
                         (left-6*size+(w+46*size)*f,y-h+1*size-9*size*f)],.13,.8,warm=True)
        self.line(c,[(right,y-9*size),(right+31*size,y-14*size),
                     (right+31*size,y-h-9*size),(right+16*size,y-h-pitch-9*size)],.28)
        for i in range(10):
            f=i/9
            self.line(c,[(left+w*f,y-9*size*f),
                         (left+w*f,y-h-9*size*f)],.14)
        door=x-32*size
        self.line(c,[(door,y-3*size),(door,y-24*size),
                     (door+14*size,y-25*size),(door+14*size,y-4*size)],.40)
        for xx in (x+18*size,x+57*size):
            c.rectangle(xx,y-h+7*size,8*size,4*size)
            c.set_source_rgba(.87,.68,.40,.21+.10*activity)
            c.fill()
        # Hearth smoke rises through a subtle roof opening.
        for puff in range(3):
            phase=(t/18+puff/3)%1
            xx=x+math.sin(t/16+puff)*phase*13
            yy=y-h-pitch-5*size-phase*48
            c.move_to(xx,yy)
            c.curve_to(xx-8,yy-5,xx+12,yy-13,xx+3,yy-22)
            c.set_source_rgba(.67,.75,.72,(1-phase)*(.08+.04*activity))
            c.set_line_width(2*size)
            c.stroke()

    def person(self,c,x,y,t,index,carrying=False,action="walk"):
        step=math.sin(t*2.5+index)*1.3 if action in ("walk","carry","timber","tools","cart","sack","fish-carry","bread","herd") else 0
        # Small clothed silhouettes: shoulders, wool tunic, belt and boots.
        tint=(.49,.59,.56) if index%3 else (.59,.56,.46)
        c.arc(x,y-19,2.8,0,math.tau)
        c.set_source_rgba(.76,.72,.62,.66)
        c.fill()
        c.move_to(x-3,y-16)
        c.line_to(x+3,y-16)
        c.line_to(x+4.5,y-5)
        c.line_to(x-4.5,y-5)
        c.close_path()
        c.set_source_rgba(*tint,.82)
        c.fill()
        self.line(c,[(x-3,y-15),(x+3,y-15),(x+4.5,y-5),(x-4.5,y-5),(x-3,y-15)],.30,.8)
        self.line(c,[(x-3.5,y-9),(x+3.5,y-9)],.46,.9,warm=True)
        if action not in ('sit','eat'):
            self.line(c,[(x-2,y-5),(x-2-step,y-1),(x-4-step,y)],.52,1.9)
            self.line(c,[(x+2,y-5),(x+2+step,y-1),(x+4+step,y)],.52,1.9)
        self.line(c,[(x-3,y-14),(x-5,y-10),(x-4,y-8)],.49,1.7)
        self.line(c,[(x+3,y-14),(x+5,y-10),(x+6,y-8)],.49,1.7)
        # Hair, occasional short beard and a draped cloak keep them individual.
        c.arc(x,y-19.8,2.9,math.pi,math.tau)
        c.set_source_rgba(.22,.26,.23,.90)
        c.set_line_width(1.8)
        c.stroke()
        if index%2:
            self.line(c,[(x-1.6,y-17),(x,y-15.5),(x+1.6,y-17)],.45,1.5,warm=True)
        if index%4==0:
            c.move_to(x-3,y-16)
            c.line_to(x-6,y-6)
            c.line_to(x-2,y-5)
            c.set_source_rgba(.27,.36,.35,.85)
            c.fill()
        if action=='sit' or action=='eat':
            self.line(c,[(x-2,y-5),(x-7,y-4),(x-7,y)],.65,2)
            self.line(c,[(x+2,y-5),(x+7,y-4),(x+7,y)],.65,2)
        if action in ('wood','build','ship','smith','roof'):
            swing=(math.sin(t*2.8+index)+1)/2
            end=(x+14-3*swing,y-8-16*swing)
            self.line(c,[(x+4,y-12),end],.64,1.4,warm=True)
            if action=='wood':
                self.line(c,[(end[0]-3,end[1]-2),(end[0]+3,end[1]+2)],.68,3)
            else:
                self.line(c,[(end[0]-3,end[1]),(end[0]+3,end[1])],.65,2.5)
        elif action=='hunt':
            c.move_to(x+10,y-19)
            c.curve_to(x+20,y-12,x+20,y-8,x+10,y-2)
            c.set_source_rgba(.70,.67,.52,.55)
            c.set_line_width(1.1)
            c.stroke()
            self.line(c,[(x+10,y-19),(x+10,y-2)],.48)
            self.line(c,[(x+4,y-12),(x+22,y-12)],.50)
        elif action in ('feed','sow'):
            self.line(c,[(x+5,y-10),(x+11,y-4)],.62,2)
            for i in range(4):
                phase=(t/2+i/4)%1
                c.arc(x+10+phase*8,y-4+phase*7,.7,0,math.tau)
                c.set_source_rgba(.78,.66,.40,.45*(1-phase))
                c.fill()
        elif action in ('cook','bake','clean-fish','net','weave','eat'):
            hand=math.sin(t*1.1+index)*3
            self.line(c,[(x+3,y-13),(x+8,y-10+hand),(x+13,y-11)],.58,1.5)
            if action in ('cook','bake'):
                self.line(c,[(x+9,y-12),(x+17,y-5)],.56,1.1,warm=True)
            elif action=='eat':
                self.line(c,[(x+4,y-12),(x+6,y-16+hand*.3)],.58,1.3)
        elif action=='harvest':
            bend=math.sin(t*.9+index)*3
            self.line(c,[(x+3,y-12),(x+10,y-4+bend)],.57,1.5)
            c.arc(x+12,y-4+bend,4,0,math.pi)
            c.set_source_rgba(.70,.73,.63,.5)
            c.set_line_width(1)
            c.stroke()
        if action=='sack':
            c.save()
            c.translate(x+8,y-10)
            c.scale(4,6)
            c.arc(0,0,1,0,math.tau)
            c.set_source_rgba(.58,.48,.31,.75)
            c.fill()
            c.restore()
        elif action=='fish-carry':
            self.line(c,[(x+5,y-11),(x+14,y-9),(x+19,y-11),(x+19,y-7),(x+14,y-9)],.65,1.7)
        elif action=='bread':
            c.arc(x+9,y-10,4,math.pi,math.tau)
            c.set_source_rgba(.76,.58,.33,.72)
            c.fill()
        if action=='timber':
            for i in range(3):
                self.line(c,[(x-8,y-10-i*2),(x+15,y-8-i*2)],.55,1.5,warm=True)
        elif action=='tools':
            self.line(c,[(x+6,y-10),(x+10,y-4),(x+13,y-9)],.62,1.8)
            self.line(c,[(x+5,y-5),(x+11,y-13)],.56,1.5,warm=True)
        elif action=='handoff':
            self.line(c,[(x+4,y-12),(x+13,y-10)],.57,2)
        if carrying or action=='carry':
            c.rectangle(x+5,y-12,7,6)
            c.set_source_rgba(.36,.31,.23,.80)
            c.fill()
            self.line(c,[(x+5,y-12),(x+12,y-12),(x+12,y-6),(x+5,y-6),(x+5,y-12)],.43,.8,warm=True)

    def boat(self,c,x,y,size,t,alpha=.57):
        # Anchor visible hull at the waterline, excluding the raster's margins.
        left,top,right,bottom=self.ship_bounds
        scale=size/self.ship_ink_width
        c.save()
        c.translate(x-size/2-left*scale,y-bottom*scale+math.sin(t/3)*1.2)
        c.scale(scale,scale)
        c.set_source_surface(self.ship,0,0)
        c.paint_with_alpha(alpha)
        c.restore()

    def animal(self,c,x,y,t,index,deer=False):
        head=math.sin(t/7+index)*2
        self.line(c,[(x-10,y-9),(x+8,y-9),(x+13,y-15+head),(x+19,y-14+head)],.46,1.6)
        for dx in (-8,-3,5,9):
            self.line(c,[(x+dx,y-8),(x+dx+math.sin(t+index+dx),y)],.38,1.4)
        if deer:
            self.line(c,[(x+14,y-15),(x+13,y-23),(x+9,y-26)],.39)
            self.line(c,[(x+13,y-23),(x+18,y-26)],.39)
        else:
            self.line(c,[(x+13,y-15+head),(x+9,y-19+head)],.42)
        self.line(c,[(x-10,y-9),(x-15,y-12)],.32)

    def torsburgen(self,c):
        """A distant limestone plateau and enclosing wall above the left forest."""
        c.save()
        c.translate(80,655)
        cliff=[(0,72),(18,42),(51,28),(106,20),(162,24),(219,18),
               (275,31),(310,55),(327,78),(0,72)]
        c.move_to(*cliff[0])
        for point in cliff[1:]:
            c.line_to(*point)
        c.set_source_rgba(.24,.29,.27,.35)
        c.fill()
        self.line(c,cliff,.15,1)
        # The wall follows the plateau, with a low front gate and no tall towers.
        back=[(27,39),(51,26),(111,16),(177,20),(234,18),(278,30),(296,43)]
        front=[(27,39),(45,47),(91,53),(144,55),(193,52),(243,47),(296,43)]
        self.line(c,back,.20,1.1)
        self.line(c,front,.24,1.2)
        self.line(c,[(x,y+7) for x,y in front],.16,1)
        for x,y in front[1:-1]:
            self.line(c,[(x,y),(x-2,y+7)],.13,.7)
        self.line(c,[(137,62),(137,54),(146,54),(146,62)],.21,.8)
        for x,y in [(18,49),(53,56),(87,62),(177,61),(257,55),(296,59)]:
            self.line(c,[(x,y),(x-5,y+13),(x-3,y+19)],.12,.8)
        # Low woodland inside the enclosure dissolves into the distant haze.
        for i in range(13):
            x=65+i*12; y=35+math.sin(i*1.8)*3
            self.line(c,[(x-4,y+4),(x,y-3),(x+5,y+4)],.11,.7)
        c.restore()

    def draw(self,c,width,height,t,activity=.08,heat=None,network=0):
        c.save()
        # Uniform scale prevents ultrawide/resolution changes stretching bodies.
        scale=min(width/WORLD_WIDTH,height/WORLD_HEIGHT)*.90
        dusk=evening_light(t)
        warmth=0 if heat is None else max(0,min(1,(heat-55)/35))
        sky=self.cairo.LinearGradient(0,0,0,height)
        sky.add_color_stop_rgb(0,.045+.025*warmth-.012*dusk,.070-.015*dusk,.105-.012*dusk)
        sky.add_color_stop_rgb(.58,.11+.025*warmth,.155-.02*dusk,.19-.01*dusk)
        sky.add_color_stop_rgb(.78,.18+.025*warmth,.19-.02*dusk,.19-.02*dusk)
        sky.add_color_stop_rgb(1,.075+.035*warmth,.125,.145)
        c.set_source(sky)
        c.paint()
        c.translate((width-WORLD_WIDTH*scale)/2,height-WORLD_HEIGHT*scale-25*scale)
        c.scale(scale,scale)
        c.set_source_rgba(.55,.65,.58,.028)
        c.arc(1710,420,58,0,math.tau)
        c.fill()
        # Soft layers of sea cloud, a pale moon and sparse evening stars.
        for i in range(7):
            x=190+i*290+math.sin(t/420+i)*28
            y=350+(i%3)*92
            cloud=self.cairo.RadialGradient(x,y,8,x,y,105)
            cloud.add_color_stop_rgba(0,.53,.60,.64,.045)
            cloud.add_color_stop_rgba(1,.53,.60,.64,0)
            c.save()
            c.translate(x,y)
            c.scale(2.1,.26)
            c.translate(-x,-y)
            c.set_source(cloud)
            c.arc(x,y,105,0,math.tau)
            c.fill()
            c.restore()
        c.arc(1710,420,12,0,math.tau)
        c.set_source_rgba(.80,.83,.74,.13+.16*dusk)
        c.fill()
        for i in range(26):
            r=random.Random(600+i)
            c.arc(r.uniform(80,2070),r.uniform(70,490),r.uniform(.6,1.1),0,math.tau)
            c.set_source_rgba(.75,.81,.83,.20*dusk)
            c.fill()
        self.line(c,[(0,730),(350,716),(780,732),(1300,709),(1750,725),(2160,731)],.12)
        coast=COAST
        c.move_to(-160,730)
        c.line_to(2320,730)
        for point in reversed(coast):
            c.line_to(*point)
        c.close_path()
        c.set_source_rgba(.16,.22,.21,.55)
        c.fill()
        self.line(c,coast,.32,1.4)
        self.torsburgen(c)
        for x,y,size in sorted(self.trees,key=lambda v:v[1]):
            c.move_to(x-size*.55,y)
            c.line_to(x,y-size*1.6)
            c.line_to(x+size*.55,y)
            c.close_path()
            c.set_source_rgb(.145,.20,.19)
            c.fill()
            self.line(c,[(x,y),(x,y-size*1.4)],.20)
            self.line(c,[(x-size*.45,y-size*.3),(x,y-size*1.6),(x+size*.45,y-size*.3)],.18)
            self.line(c,[(x-size*.55,y-size*.1),(x,y-size*1.1),(x+size*.55,y-size*.1)],.15)
        for x,y,size,start in HOUSES:
            progress=1 if start==0 else max(0,min(1,(t-start)/600))
            if progress>0:
                self.house(c,x,y,size,progress,t,activity+dusk*.8)
        # Small east field, grain store, cooking shelter and low communal fire.
        phase=t%DAY_LENGTH
        grain=max(.08,min(1,(phase-130)/260)) if phase<450 else max(.08,1-(phase-450)/500)
        for row in range(6):
            yy=850+row*14
            self.line(c,[(1960,yy),(2115,yy+8)],.16,.9,warm=True)
            for column in range(16):
                xx=1965+column*9
                hh=grain*(7+column%3)
                self.line(c,[(xx,yy),(xx+1,yy-hh),(xx+3,yy-hh+2)],.28,.8,warm=True)
        for i in range(5):
            self.line(c,[(1630+i*9,855),(1632+i*9,845),(1638+i*9,845),(1640+i*9,855)],.29,warm=True)
        self.line(c,[(1490,1020),(1490,990),(1535,990),(1535,1020)],.31)
        self.line(c,[(1480,990),(1510,966),(1545,990)],.35)
        self.line(c,[(1553,1050),(1553,1032),(1565,1018),(1580,1018),(1591,1032),(1591,1050)],.37,warm=True)
        self.line(c,[(1570,1049),(1570,1036),(1580,1036),(1580,1049)],.44,warm=True)
        for i in range(3):
            c.arc(1573+i*3,1042,2,0,math.tau)
            c.set_source_rgba(.95,.56,.23,.25+.08*math.sin(t*1.4+i))
            c.fill()
        c.save()
        c.translate(SUPPER_X-1480,SUPPER_Y-1100)
        self.line(c,[(1480,1093),(1550,1093),(1550,1098),(1480,1098)],.39,1.5,warm=True)
        self.line(c,[(1472,1128),(1550,1128)],.33,2,warm=True)
        c.restore()
        self.line(c,[(1673,922),(1710,922),(1710,930),(1673,930)],.34,1.8,warm=True)
        # Repair net and a weaving frame stand beside the cooking shelter.
        for i in range(6):
            self.line(c,[(1420+i*5,1000),(1425+i*5,1025)],.22,.8)
            self.line(c,[(1420,1000+i*5),(1447,1000+i*5)],.22,.8)
        self.line(c,[(1450,1030),(1450,995),(1475,995),(1475,1030)],.36)
        for i in range(8):
            self.line(c,[(1453+i*3,998),(1453+i*3,1028)],.23,.8,warm=True)
        c.save()
        c.translate(SUPPER_X-1480,SUPPER_Y-1100)
        for i in range(5):
            yy=1098-i*2
            self.line(c,[(1565,yy),(1578,yy-3)],.29,1.3,warm=True)
            c.arc(1570+i*2,1090,2+math.sin(t*2+i),0,math.tau)
            c.set_source_rgba(.95,.52,.20,.26+.12*dusk)
            c.fill()
        c.restore()
        # Footpaths connect doors, work sites and the quay.
        for x,y,size,start in HOUSES[:3]:
            self.line(c,[(x-25*size,y),(x-25*size,y+38),(1340,y+38),(1380,1040)],.08)
        for x in (1220,1290):
            self.line(c,[(x,1020),(x,992),(x+45,992),(x+45,1020)],.29)
            self.line(c,[(x-5,991),(x+22,976),(x+50,991)],.34)
        # Opaque rear wall and roof; the open front reveals the forge tools.
        for polygon,color in [([(1095,945),(1095,896),(1250,896),(1250,945)],(.14,.20,.20)),
                              ([(1082,897),(1118,854),(1235,854),(1267,897)],(.21,.25,.22))]:
            c.move_to(*polygon[0])
            for point in polygon[1:]: c.line_to(*point)
            c.close_path()
            c.set_source_rgb(*color)
            c.fill()
        self.line(c,[(1095,945),(1095,896),(1250,896),(1250,945)],.32,1.7)
        self.line(c,[(1082,897),(1118,854),(1235,854),(1267,897),(1082,897)],.40)
        self.line(c,[(1215,880),(1215,832),(1230,832),(1230,881)],.27)
        self.line(c,[(1196,927),(1196,910),(1234,910),(1234,927),(1196,927)],.40)
        for i in range(4):
            forging=145 <= t%480 < 220
            glow=(.30 if forging else .13)+.08*math.sin(t*2+i)
            c.set_source_rgba(.95,.47,.17,glow)
            c.arc(1205+i*6,914,2.5+math.sin(t*3+i)*.5,0,math.tau)
            c.fill()
        self.line(c,[(1158,927),(1165,922),(1187,922),(1194,927),(1180,929),
                     (1180,940),(1168,940),(1168,929),(1158,927)],.54,1.5)
        bellows=math.sin(t*1.5)*3 if forging else 0
        self.line(c,[(1235,916),(1253,912-bellows),(1253,923),(1235,918)],.35,warm=True)
        for i in range(3):
            phase=(t/12+i/3)%1
            self.line(c,[(1221,831-40*phase),(1224+8*phase,820-40*phase)],.09*(1-phase),2)
        # Woodcutting stump and stacked timber; nearby shipwright's slipway.
        self.line(c,[(402,863),(402,850),(420,850),(420,863)],.43)
        for k in range(7):
            self.line(c,[(575+k*3,938-k*3),(635+k*3,938-k*3)],.30,2,warm=True)
        self.line(c,[(450,1050),(710,1050)],.28,2)
        self.line(c,[(470,1061),(695,1061)],.24,2)
        ship_phase=(t%480)/480
        if ship_phase<410/480:
            progress=max(0,min(1,(ship_phase*480-278)/132))
            self.line(c,[(465,1039),(505,1051),(665,1051),(708,1028)],.42,2)
            for i in range(10):
                xx=490+i*21
                self.line(c,[(xx-8,1047),(xx,1012),(xx+8,1047)],.30)
            for j in range(int(progress*7)):
                self.line(c,[(480,1044-j*4),(685,1044-j*4)],.36,1.5,warm=True)
            if progress>.7:
                self.line(c,[(585,1045),(585,974)],.40,2)
        else:
            f=(ship_phase*480-410)/70
            self.boat(c,590-230*f,1080+170*f,210,t,.55*(1-f))
        # Animal pen, trough and goats; herd stays on land.
        self.line(c,[(1735,1040),(1900,1040),(1925,1110),(1755,1110),(1735,1040)],.22)
        for x in range(1750,1910,25):
            self.line(c,[(x,1045),(x,1029)],.25)
        self.line(c,[(1762,1066),(1797,1066),(1793,1075),(1766,1075),(1762,1066)],.38,warm=True)
        herder=daily_actors(t)[5]
        herd_mix=max(0,min(1,(phase-170)/60,(880-phase)/80))
        herd_mix=herd_mix*herd_mix*(3-2*herd_mix)
        gx,gy=herder['position']
        for i in range(4):
            px,py=1800+i*25+math.sin(t/27+i)*8,1084+i%2*12
            self.animal(c,px+(gx-22-i*18-px)*herd_mix,
                        py+(gy+12+i%2*9-py)*herd_mix,t,i)
        for i in range(7):
            xx=1715+i*15+math.sin(t/19+i)*11
            yy=971+i%3*8+math.sin(t/23+i)*4
            self.line(c,[(xx-4,yy-4),(xx+3,yy-5),(xx+6,yy-9),(xx+8,yy-8)],.44,1.6)
            self.line(c,[(xx-1,yy-2),(xx-1,yy),(xx+3,yy-2),(xx+3,yy)],.32,.8)
        # Docked ship has a real mooring interval for cargo handling.
        self.line(c,[(1380,1038),(1350,1200),(1390,1202),(1418,1040)],.34)
        for i in range(13):
            f=i/13
            self.line(c,[(1380-30*f,1038+162*f),(1418-28*f,1040+162*f)],.23)
        for i in range(12):
            phase=(t/34+i/12)%1
            yy=1170+phase*180
            c.move_to(-160,yy)
            c.curve_to(700,yy-7,1450,yy+6,2320,yy-2)
            c.set_source_rgba(.60,.76,.75,.10*math.sin(math.pi*phase)**2)
            c.set_line_width(1)
            c.stroke()
        travel,docked=voyage_state(t)
        self.boat(c,1240-730*travel,1190+90*travel,210-35*travel,t,.62)
        # Secondary trader follows a different route; traffic increases its light.
        other,_=voyage_state(t+170)
        self.boat(c,1530+430*other,1250+55*other,180-25*other,t+8,.24+.20*network)
        if docked:
            for i in range(3):
                self.line(c,[(1370,1170-i*7),(1382,1170-i*7),(1382,1177-i*7)],.42,warm=True)
            # A visible gangplank joins the hull and the cargo quay.
            self.line(c,[(1334,1170),(1370,1170)],.38,2)
        # Fish from the quay and a small open rowing boat at consistent scale.
        skiff=800+60*math.sin(t/100)
        self.line(c,[(skiff-28,1280),(skiff-16,1292),(skiff+18,1292),(skiff+30,1280)],.40,1.5)
        self.person(c,skiff,1284,t,2,action='fish')
        self.line(c,[(skiff+4,1270),(skiff+42,1300)],.32)
        active_site=next(((x,y,size) for x,y,size,start in HOUSES if start>0 and start<t<start+600),HOUSES[-1][:3])
        jobs=[('hunt',(330,795)),('feed',(1762,1070)),
              ('build',(active_site[0]+65,active_site[1]+8)),
              ('wood',(425,875)),('ship',(650,1040)),('feed',(1785,1070)),
              ('load',(1378,1130) if docked else (1310,1024)),('build',(active_site[0]-60,active_site[1]+8))]
        # Shared-clock crews connect the economy; independent helpers respond
        # to CPU activity without speeding up or interrupting those handoffs.
        workers=3+int(max(0,min(1,activity))*5)
        states=[(state['position'][1],30+i,state) for i,state in enumerate(connected_actors(t)) if state['visible']]
        states += [(s['position'][1],50+i,s) for i,s in enumerate(daily_actors(t)) if s['visible']]
        fuel=t%480
        if 135 <= fuel < 220:
            for i in range(4):
                self.line(c,[(1248,934-i*3),(1272,934-i*3)],.41,1.5,warm=True)
        if 220 <= fuel < 268:
            self.line(c,[(1130,941),(1145,932),(1149,937)],.49,1.5)
        trading=(t+60)%360
        if 36 <= trading < 95:
            for i in range(4):
                self.line(c,[(1260+i*12,1010),(1260+i*12,997),(1270+i*12,997),
                             (1270+i*12,1010)],.38,warm=True)
        for i,(task,destination) in enumerate(jobs[:workers]):
            hx,hy,hs,_=HOUSES[i%3]
            state=hunting_state(t) if task=='hunt' else worker_state(t,i,(hx-25*hs,hy-3),destination,task)
            if state['visible']:
                states.append((state['position'][1],i,state))
        for _,i,state in sorted(states):
            x,y=state['position']
            action=state['action']
            if action=='load':
                action='carry'
            self.person(c,x,y,t,i+3,action=action)
            if action=='fish':
                self.line(c,[(x+6,y-8),(x+34,y-44+math.sin(t/7)*3),(x+55,y+48)],.29)
            if action=='cart':
                self.line(c,[(x-36,y-6),(x-36,y-17),(x-13,y-17),(x-13,y-6),
                             (x-36,y-6),(x-8,y-10)],.44,1.4,warm=True)
                for xx in (x-31,x-17):
                    c.arc(xx,y-3,3.4,0,math.tau)
                    c.set_source_rgba(.65,.72,.66,.45)
                    c.set_line_width(1)
                    c.stroke()
            elif action in ('talk','trade'):
                self.line(c,[(x+4,y-13),(x+9,y-12+math.sin(t*1.5+i)*2)],.46,1.6)
            if action=='hunt' and state['flight']<1.8:
                f=state['flight']/1.8
                target_x,target_y=state['prey']
                miss=0 if state['hit'] else (-28 if state['shot']%2 else 25)
                ax=x+20+(target_x-x-20)*f
                ay=y-12+(target_y-y+miss+5)*f-15*math.sin(math.pi*f)
                self.line(c,[(ax-9,ay),(ax,ay)],.37)
        hunt=hunting_state(t)
        px,py=hunt['prey']
        c.save()
        if hunt['caught']:
            c.translate(px,py)
            c.rotate(-math.pi/2)
            self.animal(c,0,0,t,12,deer=True)
        else:
            self.animal(c,px+3*math.sin(t/9),py,t,12,deer=True)
        c.restore()
        for i in range(4):
            x=1000+i*95+math.sin(t/50+i)*65
            yy=540+math.sin(t/17+i)*9
            self.line(c,[(x-7,yy+2),(x-2,yy-1),(x,yy+1),(x+2,yy-1),(x+7,yy+2)],.23)
        c.restore()


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--render',type=Path)
    parser.add_argument('--time',type=float,default=900)
    parser.add_argument('--load',type=float,default=.12)
    args=parser.parse_args()
    if args.render:
        try:
            import cairo
        except ImportError:
            import cairocffi as cairo
        surface=cairo.ImageSurface(cairo.FORMAT_ARGB32,1440,900)
        Village(cairo).draw(cairo.Context(surface),1440,900,args.time,args.load)
        args.render.parent.mkdir(parents=True,exist_ok=True)
        surface.write_to_png(str(args.render))
        return
    from ctypes import CDLL
    CDLL('libgtk4-layer-shell.so')
    import gi
    gi.require_version('Gtk','4.0')
    gi.require_version('Gtk4LayerShell','1.0')
    gi.require_foreign('cairo')
    import cairo
    from gi.repository import Gtk,Gdk,GLib,Gio,Gtk4LayerShell as LayerShell

    class World(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='org.hafthios.World')
            self.village=Village(cairo)
            self.metrics=Telemetry()
            self.prefs=preferences()
            self.elapsed=0.
            try:
                value=json.loads((Path.home()/'.local/state/hafthios/world.json').read_text())
                elapsed=float(value.get('elapsed',0))
                if math.isfinite(elapsed) and 0 <= elapsed < 1e12:
                    self.elapsed=elapsed
            except (OSError,ValueError,TypeError,AttributeError):
                pass
            self.last=time.monotonic()
            self.last_sample=0
            self.last_save=0
            self.windows=[]
            self.draw_count=0
            self.scene_metrics=(self.metrics.load,None,0)

        def do_activate(self):
            if getattr(self,'monitors',None):
                return
            self.hold()
            self.monitors=Gdk.Display.get_default().get_monitors()
            self.monitors.connect('items-changed',self.rebuild)
            self.rebuild()
            GLib.timeout_add(83,self.tick)

        def rebuild(self,*_):
            for window,canvas in self.windows:
                window.destroy()
            self.windows=[]
            for i in range(self.monitors.get_n_items()):
                window=Gtk.ApplicationWindow(application=self,title='Hafþi · Village')
                window.set_decorated(False)
                LayerShell.init_for_window(window)
                LayerShell.set_namespace(window,'hafthios-world')
                LayerShell.set_layer(window,LayerShell.Layer.BACKGROUND)
                LayerShell.set_monitor(window,self.monitors.get_item(i))
                for edge in (LayerShell.Edge.LEFT,LayerShell.Edge.RIGHT,LayerShell.Edge.TOP,LayerShell.Edge.BOTTOM):
                    LayerShell.set_anchor(window,edge,True)
                LayerShell.set_exclusive_zone(window,-1)
                LayerShell.set_keyboard_mode(window,LayerShell.KeyboardMode.NONE)
                canvas=Gtk.DrawingArea()
                canvas.set_draw_func(self.draw)
                canvas.set_can_target(False)
                window.set_child(canvas)
                window.connect('realize',lambda w: w.get_surface().set_input_region(cairo.Region()))
                self.windows.append((window,canvas))
                window.set_visible(self.prefs['enabled'])
            self.ready_sent=False

        def draw(self,canvas,c,width,height):
            self.village.draw(c,width,height,self.elapsed,*self.scene_metrics)
            self.draw_count+=1

        def tick(self):
            now=time.monotonic()
            dt=max(0,min(1,now-self.last))  # Resume from sleep without a sudden jump.
            self.last=now
            changed=False
            if now-self.last_sample >= 3:
                prefs=preferences()
                changed=prefs != self.prefs
                self.prefs=prefs
                self.metrics.sample(now)
                self.last_sample=now
                for window,canvas in self.windows:
                    window.set_visible(prefs['enabled'])
                try:
                    runtime=Path(os.environ['XDG_RUNTIME_DIR'])/'hafthios-world.json'
                    runtime.write_text(json.dumps({'elapsed':self.elapsed, 'draws':self.draw_count, **prefs}))
                except (OSError,KeyError):
                    pass
                if not self.ready_sent and self.draw_count and any(w.get_mapped() for w,c in self.windows):
                    try:
                        with open('/dev/ttyS0','w') as serial:
                            serial.write('HAFTHIOS_WORLD_READY\n')
                    except OSError:
                        pass
                    self.ready_sent=True
            moving=self.prefs['enabled'] and not self.prefs['paused']
            if moving:
                self.elapsed+=dt
                self.scene_metrics=(self.metrics.load if self.prefs['responsive'] else .12,
                                    self.metrics.temperature if self.prefs['responsive'] else None,
                                    self.metrics.network if self.prefs['responsive'] else 0)
            if moving or changed:
                for window,canvas in self.windows:
                    canvas.queue_draw()
            if now-self.last_save >= 30:
                import runpy
                backend=runpy.run_path(str(Path(__file__).with_name('hafthios-settings')))
                try:
                    backend['atomic_write'](Path.home()/'.local/state/hafthios/world.json',json.dumps({'elapsed':self.elapsed})+'\n')
                except OSError:
                    pass
                self.last_save=now
            GLib.timeout_add(frame_interval(self.prefs,self.metrics),self.tick)
            return False

    World().run([sys.argv[0]])


if __name__ == '__main__':
    main()
