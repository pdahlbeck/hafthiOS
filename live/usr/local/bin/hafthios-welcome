}


def main():
    import gi
    gi.require_version('Gtk', '4.0')
    from gi.repository import Gtk, Gdk, GLib, Gio, Pango

    class Welcome(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='org.hafthios.Welcome',
                             flags=Gio.ApplicationFlags.NON_UNIQUE)
            self.settings_backend = runpy.run_path(str(Path(__file__).with_name('hafthios-settings')))
            self.settings = self.settings_backend['read_settings']()
            self.translatable = []
            self.disks = []
            self.guide_entries = []
            self.guide_directory = Path("/usr/share/doc/hafthios")
            self.guide_source_visible = False

        def do_activate(self):
            css = Gtk.CssProvider()
            css.load_from_data(b'''
                window { background: #101e28; color: #ecf4f5; }
                .brand { font-size: 16px; color: #80d6d1; font-weight: bold; }
                .title { font-size: 44px; font-weight: bold; }
                .desktop .title { font-size: 30px; }
                .subtitle { font-size: 18px; color: #b8cdd5; }
                .muted { color: #9cb3be; }
                .notice { background: #1b303b; border-radius: 12px; padding: 18px; }
                button { border-radius: 9px; padding: 12px 22px; }
                button.suggested-action { background: #76d1c7; color: #10262d; }
            ''')
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.window = Gtk.ApplicationWindow(application=self, title='Hafþi OS')
            self.window.set_default_size(960, 680)
            if '--desktop' not in sys.argv:
                self.window.fullscreen()
            else:
                self.window.set_default_size(440, 680)
                self.window.add_css_class('desktop')
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
            for side in ('top', 'bottom', 'start', 'end'):
                getattr(root, 'set_margin_' + side)(24 if '--desktop' in sys.argv else 48)
            self.window.set_child(root)
            root.append(self.label('HAFÞI OS  /  LIVE DESKTOP', 'brand'))
            self.pages = Gtk.Stack()
            self.pages.set_vexpand(True)
            self.pages.set_vhomogeneous(False)
            self.pages.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
            content = Gtk.ScrolledWindow()
            content.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            content.set_vexpand(True)
            content.set_child(self.pages)
            root.append(content)
            self.build_welcome()
            self.build_desktop()
            self.build_disk_page()
            self.build_review_page()
            self.build_guide_page()
            self.build_settings_page()
            self.build_network_page()
            self.build_error_page()
            keys = Gtk.EventControllerKey()
            keys.connect('key-pressed', self.guide_key)
            self.window.add_controller(keys)
            root.append(self.label('Prototype preview · Your disks will not be changed.', 'muted'))
            if '--desktop' in sys.argv:
                self.pages.set_visible_child_name('desktop')
                GLib.timeout_add_seconds(2, self.desktop_ready)
            if '--session-error' in sys.argv:
                self.pages.set_visible_child_name('error')
            if '--settings' in sys.argv:
                self.show_settings(None)
            if '--guide' in sys.argv:
                self.show_guide(None)
            self.window.present()
            GLib.idle_add(self.boot_ready)

        def boot_ready(self):
            # Serial marker lets the VM smoke test check that GTK reached the UI.
            try:
                with open('/dev/ttyS0', 'w') as serial:
                    serial.write('HAFTHIOS_GUI_READY\n')
            except OSError:
                pass
            return False

        def tr(self, text):
            return SWEDISH.get(text, text) if self.settings['language'] == 'sv' else text

        def translate_widgets(self):
            for widget, source in self.translatable:
                widget.set_label(self.tr(source))

        def label(self, text, style=None):
            label = Gtk.Label(label=self.tr(text), xalign=0)
            self.translatable.append((label, text))
            label.set_wrap(True)
            if style:
                label.add_css_class(style)
            return label

        def page(self, name, title, subtitle):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22)
            page.set_valign(Gtk.Align.CENTER)
            page.append(self.label(title, 'title'))
            page.append(self.label(subtitle, 'subtitle'))
            self.pages.add_named(page, name)
            return page

        def button(self, text, action, primary=False):
            button = Gtk.Button(label=self.tr(text))
            self.translatable.append((button, text))
            button.set_halign(Gtk.Align.START)
            button.connect('clicked', action)
            if primary:
                button.add_css_class('suggested-action')
            return button

        def build_welcome(self):
            page = self.page('welcome', 'A quiet desktop.\nA powerful terminal.',
                             'Arch Linux, Wayland and Hafþi. A simpler place to start.')
            note = self.label('Try the desktop from USB. Disk installation is still a preview.', 'notice')
            page.append(note)
            page.append(self.button('Try the desktop', self.try_desktop, True))
            page.append(self.button('Preview installation', self.show_disks))
            page.append(self.button('Hafþi OS Guide', self.show_guide))
            page.append(self.button('Language and keyboard', self.show_settings))
            page.append(self.button('Network settings', self.network))
            page.append(self.button('Restart', self.restart))

        def try_desktop(self, _):
            Path(os.environ['XDG_RUNTIME_DIR'], 'hafthios-try-desktop').touch()
            self.quit()

        def build_desktop(self):
            page = self.page('desktop', 'Welcome aboard.', 'Your Hafþi OS live desktop.')
            page.set_spacing(12)
            page.append(self.button('Open Hafþi', lambda _: subprocess.Popen(['hafthios-terminal']), True))
            page.append(self.button('Open Google Chrome', lambda _: subprocess.Popen(['hafthios-chrome'])))
            page.append(self.button('Hafþi OS Guide', self.show_guide))
            page.append(self.button('Language and keyboard', self.show_settings))
            page.append(self.button('Network settings', self.network))
            page.append(self.label('Super + Enter  ·  Terminal\nSuper + B  ·  Browser\nSuper + G  ·  File guide\nSuper + ← / →  ·  Switch windows\nSuper + Q  ·  Close window', 'notice'))
            page.append(self.button('Restart', self.restart))

        def desktop_ready(self):
            try:
                result = subprocess.run(['niri', 'msg', '--json', 'windows'], capture_output=True, text=True, timeout=5, check=True)
                with open('/dev/ttyS0', 'w') as serial:
                    serial.write('HAFTHIOS_DESKTOP_READY ' + result.stdout + '\n')
            except (OSError, subprocess.SubprocessError):
                pass
            return True

        def guide_key(self, controller, keyval, keycode, state):
            if keyval == Gdk.KEY_F2 and '--desktop' not in sys.argv:
                self.try_desktop(None)
                return True
            if keyval == Gdk.KEY_Escape and self.pages.get_visible_child_name() in ('settings', 'network', 'error'):
                self.return_home(None)
                return True
            if keyval == Gdk.KEY_F3:
                self.show_settings(None)
                return True
            if keyval == Gdk.KEY_F1:
                self.show_guide(None)
                return True
            return False

        def build_guide_page(self):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            page.append(self.label('Hafþi OS File Guide', 'subtitle'))
            self.guide_search = Gtk.SearchEntry()
            self.guide_search.set_placeholder_text('Search files and explanations…')
            self.guide_search.connect('search-changed', self.filter_guide)
            page.append(self.guide_search)
            self.guide_mode = Gtk.DropDown.new_from_strings(['All ISO files', 'Project source guide'])
            self.guide_mode.connect('notify::selected', lambda *_: self.show_guide(None))
            page.append(self.guide_mode)
            self.inventory_status = self.label('', 'muted')
            page.append(self.inventory_status)
            columns = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
            columns.set_vexpand(True)
            columns.set_position(340)
            columns.set_resize_start_child(False)
            columns.set_shrink_start_child(True)
            columns.set_resize_end_child(True)
            self.guide_list = Gtk.ListBox()
            self.guide_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.guide_list.connect('row-selected', self.select_guide_article)
            navigation = Gtk.ScrolledWindow()
            navigation.set_min_content_width(300)
            navigation.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            navigation.set_child(self.guide_list)
            columns.set_start_child(navigation)
            self.guide_text = Gtk.TextView()
            self.guide_text.set_editable(False)
            self.guide_text.set_cursor_visible(False)
            self.guide_text.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            self.guide_text.set_left_margin(20)
            self.guide_text.set_right_margin(20)
            self.guide_text.set_top_margin(14)
            self.guide_text.set_bottom_margin(14)
            reading = Gtk.ScrolledWindow()
            reading.set_child(self.guide_text)
            columns.set_end_child(reading)
            page.append(columns)
            controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            controls.append(self.button('Back to welcome', lambda _: self.pages.set_visible_child_name('desktop' if '--desktop' in sys.argv else 'welcome')))
            self.source_button = self.button('Show source', self.toggle_guide_source)
            controls.append(self.source_button)
            self.inventory_previous = self.button('Previous', lambda _: self.inventory_page(-1))
            self.inventory_next = self.button('Next', lambda _: self.inventory_page(1))
            controls.append(self.inventory_previous)
            controls.append(self.inventory_next)
            page.append(controls)
            self.pages.add_named(page, 'guide')

        def show_guide(self, _):
            self.pages.set_visible_child_name('guide')
            try:
                if getattr(self, 'inventory_db', None) is not None:
                    self.inventory_db.close()
                    self.inventory_db = None
                self.inventory_active = self.guide_mode.get_selected() == 0
                self.inventory_offset = 0
                if self.inventory_active:
                    self.inventory_db = sqlite3.connect(f'file:{self.guide_directory / "file-register.sqlite"}?mode=ro', uri=True)
                    self.inventory_db.row_factory = sqlite3.Row
                    self.guide_entries = []
                    self.filter_guide(self.guide_search)
                    GLib.idle_add(self.guide_ready)
                    return
                catalog = json.loads((self.guide_directory / 'file-guide.json').read_text())
                self.guide_entries = catalog['files']
                if not self.guide_entries:
                    raise ValueError('The file guide is empty')
                self.filter_guide(self.guide_search)
                GLib.idle_add(self.guide_ready)
            except (OSError, ValueError, KeyError, sqlite3.Error) as error:
                self.guide_text.get_buffer().set_text(f'The local guide could not be opened: {error}')
                self.source_button.set_sensitive(False)

        def guide_ready(self):
            try:
                with open('/dev/ttyS0', 'w') as serial:
                    serial.write('HAFTHIOS_GUIDE_READY\n')
                    if self.inventory_active:
                        count = self.inventory_db.execute('SELECT count(*) FROM files').fetchone()[0]
                        serial.write(f'HAFTHIOS_INVENTORY_READY {count}\n')
            except OSError:
                pass
            return False

        def inventory_page(self, direction):
            self.inventory_offset = max(0, self.inventory_offset + direction * 100)
            self.filter_guide(self.guide_search, reset=False)

        def filter_guide(self, search, reset=True):
            query = search.get_text().casefold().strip()
            while self.guide_list.get_first_child() is not None:
                self.guide_list.remove(self.guide_list.get_first_child())
            if getattr(self, 'inventory_active', False):
                if reset:
                    self.inventory_offset = 0
                token = '%' + query.replace('\\', '\\\\').replace('%', '\\%').replace('_', '\\_') + '%'
                where = "WHERE path LIKE ? ESCAPE '\\' OR package LIKE ? ESCAPE '\\' OR layer LIKE ? ESCAPE '\\'"
                parameters = (token, token, token)
                total = self.inventory_db.execute('SELECT count(*) FROM files ' + where, parameters).fetchone()[0]
                entries = [dict(row) for row in self.inventory_db.execute(
                    'SELECT * FROM files ' + where + " ORDER BY CASE layer WHEN 'Live system' THEN 0 ELSE 1 END,layer,path LIMIT 100 OFFSET ?",
                    parameters + (self.inventory_offset,))]
                self.inventory_status.set_text(f'{total:,} entries matching · {self.inventory_offset + 1 if total else 0}–{min(total, self.inventory_offset + 100):,} · Search path, package or layer')
                self.inventory_previous.set_sensitive(self.inventory_offset > 0)
                self.inventory_next.set_sensitive(self.inventory_offset + 100 < total)
            else:
                entries = self.guide_entries
                self.inventory_status.set_text('Project source explanations and snapshots')
                self.inventory_previous.set_sensitive(False)
                self.inventory_next.set_sensitive(False)
            for entry in entries:
                searchable = ' '.join([entry['path'], entry['purpose']] + entry.get('details', [])).casefold()
                if not self.inventory_active and query not in searchable:
                    continue
                row = Gtk.ListBoxRow()
                row.article = entry
                row.set_tooltip_text(entry['path'])
                label = self.label((entry['layer'] + '\n' if self.inventory_active else '') + entry['path'])
                label.set_max_width_chars(38)
                label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                label.set_margin_top(10)
                label.set_margin_bottom(10)
                label.set_margin_start(10)
                label.set_margin_end(10)
                row.set_child(label)
                self.guide_list.append(row)
            first = self.guide_list.get_row_at_index(0)
            self.guide_list.select_row(first)
            if first is None:
                self.guide_text.get_buffer().set_text('No files match your search.')
                self.source_button.set_sensitive(False)

        def select_guide_article(self, listbox, row):
            if row is None:
                return
            self.guide_source_visible = False
            self.source_button.set_label('Show source')
            self.source_button.set_sensitive(not self.inventory_active)
            self.display_guide_article(row.article)

        def display_guide_article(self, article):
            self.guide_text.set_monospace(self.guide_source_visible)
            if getattr(self, 'inventory_active', False):
                def value(key):
                    return str(article[key]) if article[key] is not None and article[key] != '' else 'Not assigned / not applicable'
                text = (article['layer'] + '  ' + article['path'] + '\n\n'
                        + '\n'.join(f'{label}: {value(key)}' for label,key in
                            [('Type','kind'),('Size in bytes','bytes'),('Permissions','mode'),
                             ('UID','uid'),('GID','gid'),('Link target','target'),
                             ('Package owner','package'),('Package version','version')])
                        + '\n\nPACKAGE DESCRIPTION (package metadata)\n' + value('package_description')
                        + '\n\nFILE ROLE\n' + article['purpose']
                        + '\n\nEXPLANATION EVIDENCE\n' + article['evidence'])
            elif self.guide_source_visible:
                path = Path(article['path'])
                if path.is_absolute() or '..' in path.parts:
                    text = 'Invalid source path in the guide.'
                else:
                    try:
                        text = (self.guide_directory / 'sources' / path).read_text()
                    except UnicodeDecodeError:
                        text = 'This is a binary image asset. See the explanation for its purpose and installation path.'
                    except OSError as error:
                        text = f'The bundled source could not be read: {error}'
            else:
                text = (article['path'] + '\n\n' + article['purpose']
                        + '\n\nWHEN IT IS USED\n' + article['when']
                        + '\n\nHOW IT WORKS\n\n' + '\n\n'.join(article['details'])
                        + '\n\nCONNECTED FILES\n' + '\n'.join(article['connections']))
            self.guide_text.get_buffer().set_text(text)

        def toggle_guide_source(self, _):
            row = self.guide_list.get_selected_row()
            if row is None:
                return
            self.guide_source_visible = not self.guide_source_visible
            self.source_button.set_label('Show explanation' if self.guide_source_visible else 'Show source')
            self.display_guide_article(row.article)

        def build_disk_page(self):
            page = self.page('disks', 'Choose your disk',
                             'Preview a target disk. Nothing will be erased or installed.')
            self.disk_choice = Gtk.DropDown.new_from_strings(['Scanning disks…'])
            page.append(self.disk_choice)
            self.disk_status = self.label('', 'muted')
            page.append(self.disk_status)
            self.continue_button = self.button('Review installation', self.review, True)
            page.append(self.continue_button)
            page.append(self.button('Back', lambda _: self.pages.set_visible_child_name('desktop' if '--desktop' in sys.argv else 'welcome')))

        def show_disks(self, _):
            self.pages.set_visible_child_name('disks')
            try:
                self.disks = read_disks()
                labels = [disk_label(disk) for disk in self.disks] or ['No writable disks found']
                self.disk_choice.set_model(Gtk.StringList.new(labels))
                self.disk_choice.set_selected(0)
                self.continue_button.set_sensitive(bool(self.disks))
                self.disk_status.set_text('Choose a disposable virtual disk when testing in a VM.')
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                self.disks = []
                self.continue_button.set_sensitive(False)
                self.disk_status.set_text(f'Could not read disks: {error}')

        def build_review_page(self):
            page = self.page('review', 'Meet your new desktop',
                             'A preview of the system we are building.')
            self.summary = self.label('', 'notice')
            page.append(self.summary)
            page.append(self.label('Installation is unavailable in Prototype 01.\nThis preview has not changed your disk.', 'muted'))
            page.append(self.button('Back', lambda _: self.pages.set_visible_child_name('disks')))
            page.append(self.button('Return to welcome', lambda _: self.pages.set_visible_child_name('desktop' if '--desktop' in sys.argv else 'welcome'), True))

        def review(self, _):
            index = self.disk_choice.get_selected()
            if index >= len(self.disks):
                return
            disk = self.disks[index]
            self.summary.set_text('Selected disk: ' + disk_label(disk)
                                  + '\n\nPlanned system: Arch Linux'
                                  + '\nDesktop: Niri / Wayland'
                                  + '\nTerminal: Hafþi'
                                  + '\nBrowser: Google Chrome'
                                  + '\n\nMode: preview only')
            self.pages.set_visible_child_name('review')

        def settings_task(self, work, finished):
            # Network queries and config validation must never freeze the GTK loop.
            def worker():
                result, error = None, None
                try:
                    result = work()
                except Exception as exc:
                    error = str(exc)
                GLib.idle_add(finished, result, error)
            threading.Thread(target=worker, daemon=True).start()

        def return_home(self, _):
            self.pages.set_visible_child_name('desktop' if '--desktop' in sys.argv else 'welcome')

        def build_settings_page(self):
            page = self.page('settings', 'Settings', 'Choose the language and keyboard for this live session.')
            page.set_spacing(12)
            page.append(self.label('Language', 'muted'))
            self.language_choice = Gtk.DropDown.new_from_strings(['English', 'Svenska'])
            page.append(self.language_choice)
            page.append(self.label('Keyboard', 'muted'))
            self.keyboard_choice = Gtk.DropDown.new_from_strings(['English (US)', 'Svenska (SE)'])
            page.append(self.keyboard_choice)
            self.apply_button = self.button('Apply', self.apply_settings, True)
            page.append(self.apply_button)
            self.settings_status = self.label('', 'notice')
            page.append(self.settings_status)
            page.append(self.label('Changes last until you restart. The file guide remains in English.', 'muted'))
            page.append(self.button('Back', self.return_home))

        def show_settings(self, _):
            self.settings = self.settings_backend['read_settings']()
            self.translate_widgets()
            self.language_choice.set_selected(1 if self.settings['language'] == 'sv' else 0)
            self.keyboard_choice.set_selected(1 if self.settings['keyboard'] == 'se' else 0)
            self.pages.set_visible_child_name('settings')
            self.language_choice.grab_focus()
            try:
                with open('/dev/ttyS0', 'w') as serial:
                    serial.write('HAFTHIOS_SETTINGS_READY\n')
            except OSError:
                pass

        def apply_settings(self, _):
            language = ('en', 'sv')[self.language_choice.get_selected()]
            keyboard = ('us', 'se')[self.keyboard_choice.get_selected()]
            self.apply_button.set_sensitive(False)
            self.settings_status.set_text(self.tr('Applying settings…'))
            def finished(result, error):
                self.apply_button.set_sensitive(True)
                if error:
                    self.settings_status.set_text(self.tr('Could not apply settings: ') + error)
                else:
                    self.settings = result
                    os.environ.update(LANG=self.settings_backend['LANGUAGES'][language],
                                      LANGUAGE=language, XKB_DEFAULT_LAYOUT=keyboard)
                    self.translate_widgets()
                    message = self.tr('Settings applied. The Niri keyboard changes immediately. New terminals use the selected language.')
                    if '--desktop' not in sys.argv:
                        message += '\n' + self.tr('In the welcome screen, the keyboard changes when you enter the desktop or reopen the welcome screen.')
                    self.settings_status.set_text(message)
                return False
            self.settings_task(lambda: self.settings_backend['apply_settings'](language, keyboard), finished)

        def build_network_page(self):
            page = self.page('network', 'Network settings', 'Connect to Wi-Fi or Ethernet for browser downloads.')
            page.set_spacing(12)
            self.network_status = self.label('', 'notice')
            page.append(self.network_status)
            self.network_button = self.button('Configure connection', self.configure_network, True)
            page.append(self.network_button)
            self.refresh_network_button = self.button('Refresh', self.refresh_network)
            page.append(self.refresh_network_button)
            page.append(self.button('Back', self.return_home))

        def network(self, _):
            self.pages.set_visible_child_name('network')
            self.refresh_network(None)

        def refresh_network(self, _):
            self.refresh_network_button.set_sensitive(False)
            self.network_status.set_text(self.tr('Checking the network…'))
            def query():
                return subprocess.run(['nmcli', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'device', 'status'],
                                      check=True, capture_output=True, text=True, timeout=10).stdout.strip()
            def finished(result, error):
                self.refresh_network_button.set_sensitive(True)
                self.network_status.set_text(self.tr('Could not read network status: ') + error if error else result)
                return False
            self.settings_task(query, finished)

        def configure_network(self, _):
            self.network_button.set_sensitive(False)
            def configure():
                subprocess.run(['foot', '--title=Live network settings', 'nmtui'], check=True)
            def finished(result, error):
                self.network_button.set_sensitive(True)
                if error:
                    self.network_status.set_text(self.tr('Could not open network settings: ') + error)
                else:
                    self.refresh_network(None)
                return False
            self.settings_task(configure, finished)

        def build_error_page(self):
            page = self.page('error', 'The desktop could not start',
                             'Check graphics acceleration in your VM. In UTM, choose virtio-vga-gl (GPU Supported), then fully restart the VM.')
            page.set_spacing(12)
            view = Gtk.TextView()
            view.set_editable(False)
            view.set_cursor_visible(False)
            view.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            try:
                text = (Path.home() / '.local/state/hafthios/desktop-error.log').read_text(errors='replace')[-12000:]
            except OSError:
                text = 'No diagnostics were recorded.'
            view.get_buffer().set_text(text)
            scroller = Gtk.ScrolledWindow()
            scroller.set_vexpand(True)
            scroller.set_min_content_height(120)
            scroller.set_child(view)
            page.append(scroller)
            page.append(self.label('Diagnostics are saved in ~/.local/state/hafthios/desktop-error.log.', 'muted'))
            page.append(self.button('Try again', self.try_desktop, True))
            page.append(self.button('Back', self.return_home))

        def restart(self, _):
            subprocess.Popen(['systemctl', 'reboot'])

    Welcome().run([sys.argv[0]])


if __name__ == '__main__':
    main()
