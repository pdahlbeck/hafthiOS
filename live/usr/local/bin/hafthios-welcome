#!/usr/bin/env python3
"""Read-only installer UI prototype. No target-disk writes are implemented."""
import json
import subprocess
import sys
from pathlib import Path


def eligible_disks(payload):
    return [disk for disk in payload.get('blockdevices', [])
            if disk.get('type') == 'disk' and not disk.get('ro')]


def disk_label(disk):
    model = str(disk.get('model') or 'Disk').strip()
    return f"{disk['path']} · {model} · {disk['size']}"


def read_disks():
    result = subprocess.run(
        ['lsblk', '--json', '--bytes', '--output', 'PATH,MODEL,SIZE,TYPE,RO'],
        check=True, capture_output=True, text=True, timeout=10)
    disks = eligible_disks(json.loads(result.stdout))
    for disk in disks:
        disk['size'] = f"{int(disk['size']) / 1_000_000_000:.1f} GB"
    return disks


def main():
    import gi
    gi.require_version('Gtk', '4.0')
    from gi.repository import Gtk, Gdk, GLib, Gio, Pango

    class Welcome(Gtk.Application):
        def __init__(self):
            super().__init__(application_id='org.hafthios.Welcome',
                             flags=Gio.ApplicationFlags.NON_UNIQUE)
            self.disks = []
            self.guide_entries = []
            self.guide_directory = Path("/usr/share/doc/hafthios")
            self.guide_source_visible = False

        def do_activate(self):
            css = Gtk.CssProvider()
            css.load_from_data(b'''
                window { background: #101e28; color: #ecf4f5; }
                .brand { font-size: 16px; color: #80d6d1; font-weight: bold; }
                .title { font-size: 44px; font-weight: bold; }
                .subtitle { font-size: 18px; color: #b8cdd5; }
                .muted { color: #9cb3be; }
                .notice { background: #1b303b; border-radius: 12px; padding: 18px; }
                button { border-radius: 9px; padding: 12px 22px; }
                button.suggested-action { background: #76d1c7; color: #10262d; }
            ''')
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.window = Gtk.ApplicationWindow(application=self, title='Hafþi OS')
            self.window.set_default_size(960, 680)
            self.window.fullscreen()
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24)
            for side in ('top', 'bottom', 'start', 'end'):
                getattr(root, 'set_margin_' + side)(48)
            self.window.set_child(root)
            root.append(self.label('HAFÞI OS  /  PROTOTYPE 01', 'brand'))
            self.pages = Gtk.Stack()
            self.pages.set_vexpand(True)
            self.pages.set_vhomogeneous(False)
            self.pages.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
            root.append(self.pages)
            self.build_welcome()
            self.build_disk_page()
            self.build_review_page()
            self.build_guide_page()
            keys = Gtk.EventControllerKey()
            keys.connect('key-pressed', self.guide_key)
            self.window.add_controller(keys)
            root.append(self.label('Prototype preview · Your disks will not be changed.', 'muted'))
            if '--guide' in sys.argv:
                self.show_guide(None)
            self.window.present()
            GLib.idle_add(self.boot_ready)

        def boot_ready(self):
            # Serial marker lets the VM smoke test check that GTK reached the UI.
            try:
                with open('/dev/ttyS0', 'w') as serial:
                    serial.write('HAFTHIOS_GUI_READY\n')
            except OSError:
                pass
            return False

        def label(self, text, style=None):
            label = Gtk.Label(label=text, xalign=0)
            label.set_wrap(True)
            if style:
                label.add_css_class(style)
            return label

        def page(self, name, title, subtitle):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22)
            page.set_valign(Gtk.Align.CENTER)
            page.append(self.label(title, 'title'))
            page.append(self.label(subtitle, 'subtitle'))
            self.pages.add_named(page, name)
            return page

        def button(self, text, action, primary=False):
            button = Gtk.Button(label=text)
            button.set_halign(Gtk.Align.START)
            button.connect('clicked', action)
            if primary:
                button.add_css_class('suggested-action')
            return button

        def build_welcome(self):
            page = self.page('welcome', 'A quiet desktop.\nA powerful terminal.',
                             'Arch Linux, Wayland and Hafþi. A simpler place to start.')
            note = self.label('Try the installation screens. Disk installation is not enabled in this first prototype.', 'notice')
            page.append(note)
            page.append(self.button('Install Hafþi OS', self.show_disks, True))
            page.append(self.button('Hafþi OS Guide', self.show_guide))
            page.append(self.button('Network settings', self.network))
            page.append(self.button('Restart', self.restart))

        def guide_key(self, controller, keyval, keycode, state):
            if keyval == Gdk.KEY_F1:
                self.show_guide(None)
                return True
            return False

        def build_guide_page(self):
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
            page.append(self.label('Hafþi OS File Guide', 'subtitle'))
            self.guide_search = Gtk.SearchEntry()
            self.guide_search.set_placeholder_text('Search files and explanations…')
            self.guide_search.connect('search-changed', self.filter_guide)
            page.append(self.guide_search)
            columns = Gtk.Paned(orientation=Gtk.Orientation.HORIZONTAL)
            columns.set_vexpand(True)
            columns.set_position(340)
            columns.set_resize_start_child(False)
            columns.set_shrink_start_child(True)
            columns.set_resize_end_child(True)
            self.guide_list = Gtk.ListBox()
            self.guide_list.set_selection_mode(Gtk.SelectionMode.SINGLE)
            self.guide_list.connect('row-selected', self.select_guide_article)
            navigation = Gtk.ScrolledWindow()
            navigation.set_min_content_width(300)
            navigation.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            navigation.set_child(self.guide_list)
            columns.set_start_child(navigation)
            self.guide_text = Gtk.TextView()
            self.guide_text.set_editable(False)
            self.guide_text.set_cursor_visible(False)
            self.guide_text.set_wrap_mode(Gtk.WrapMode.WORD_CHAR)
            self.guide_text.set_left_margin(20)
            self.guide_text.set_right_margin(20)
            self.guide_text.set_top_margin(14)
            self.guide_text.set_bottom_margin(14)
            reading = Gtk.ScrolledWindow()
            reading.set_child(self.guide_text)
            columns.set_end_child(reading)
            page.append(columns)
            controls = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=14)
            controls.append(self.button('Back to welcome', lambda _: self.pages.set_visible_child_name('welcome')))
            self.source_button = self.button('Show source', self.toggle_guide_source)
            controls.append(self.source_button)
            page.append(controls)
            self.pages.add_named(page, 'guide')

        def show_guide(self, _):
            self.pages.set_visible_child_name('guide')
            try:
                catalog = json.loads((self.guide_directory / 'file-guide.json').read_text())
                self.guide_entries = catalog['files']
                if not self.guide_entries:
                    raise ValueError('The file guide is empty')
                self.filter_guide(self.guide_search)
                GLib.idle_add(self.guide_ready)
            except (OSError, ValueError, KeyError) as error:
                self.guide_text.get_buffer().set_text(f'The local guide could not be opened: {error}')
                self.source_button.set_sensitive(False)

        def guide_ready(self):
            try:
                with open('/dev/ttyS0', 'w') as serial:
                    serial.write('HAFTHIOS_GUIDE_READY\n')
            except OSError:
                pass
            return False

        def filter_guide(self, search):
            query = search.get_text().casefold().strip()
            while self.guide_list.get_first_child() is not None:
                self.guide_list.remove(self.guide_list.get_first_child())
            for entry in self.guide_entries:
                searchable = ' '.join([entry['path'], entry['purpose']] + entry['details']).casefold()
                if query not in searchable:
                    continue
                row = Gtk.ListBoxRow()
                row.article = entry
                row.set_tooltip_text(entry['path'])
                label = self.label(entry['path'])
                label.set_max_width_chars(38)
                label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
                label.set_margin_top(10)
                label.set_margin_bottom(10)
                label.set_margin_start(10)
                label.set_margin_end(10)
                row.set_child(label)
                self.guide_list.append(row)
            first = self.guide_list.get_row_at_index(0)
            self.guide_list.select_row(first)
            if first is None:
                self.guide_text.get_buffer().set_text('No files match your search.')
                self.source_button.set_sensitive(False)

        def select_guide_article(self, listbox, row):
            if row is None:
                return
            self.guide_source_visible = False
            self.source_button.set_label('Show source')
            self.source_button.set_sensitive(True)
            self.display_guide_article(row.article)

        def display_guide_article(self, article):
            self.guide_text.set_monospace(self.guide_source_visible)
            if self.guide_source_visible:
                path = Path(article['path'])
                if path.is_absolute() or '..' in path.parts:
                    text = 'Invalid source path in the guide.'
                else:
                    try:
                        text = (self.guide_directory / 'sources' / path).read_text()
                    except OSError as error:
                        text = f'The bundled source could not be read: {error}'
            else:
                text = (article['path'] + '\n\n' + article['purpose']
                        + '\n\nWHEN IT IS USED\n' + article['when']
                        + '\n\nHOW IT WORKS\n\n' + '\n\n'.join(article['details'])
                        + '\n\nCONNECTED FILES\n' + '\n'.join(article['connections']))
            self.guide_text.get_buffer().set_text(text)

        def toggle_guide_source(self, _):
            row = self.guide_list.get_selected_row()
            if row is None:
                return
            self.guide_source_visible = not self.guide_source_visible
            self.source_button.set_label('Show explanation' if self.guide_source_visible else 'Show source')
            self.display_guide_article(row.article)

        def build_disk_page(self):
            page = self.page('disks', 'Choose your disk',
                             'Preview a target disk. Nothing will be erased or installed.')
            self.disk_choice = Gtk.DropDown.new_from_strings(['Scanning disks…'])
            page.append(self.disk_choice)
            self.disk_status = self.label('', 'muted')
            page.append(self.disk_status)
            self.continue_button = self.button('Review installation', self.review, True)
            page.append(self.continue_button)
            page.append(self.button('Back', lambda _: self.pages.set_visible_child_name('welcome')))

        def show_disks(self, _):
            self.pages.set_visible_child_name('disks')
            try:
                self.disks = read_disks()
                labels = [disk_label(disk) for disk in self.disks] or ['No writable disks found']
                self.disk_choice.set_model(Gtk.StringList.new(labels))
                self.disk_choice.set_selected(0)
                self.continue_button.set_sensitive(bool(self.disks))
                self.disk_status.set_text('Choose a disposable virtual disk when testing in a VM.')
            except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
                self.disks = []
                self.continue_button.set_sensitive(False)
                self.disk_status.set_text(f'Could not read disks: {error}')

        def build_review_page(self):
            page = self.page('review', 'Meet your new desktop',
                             'A preview of the system we are building.')
            self.summary = self.label('', 'notice')
            page.append(self.summary)
            page.append(self.label('Installation is unavailable in Prototype 01.\nThis preview has not changed your disk.', 'muted'))
            page.append(self.button('Back', lambda _: self.pages.set_visible_child_name('disks')))
            page.append(self.button('Return to welcome', lambda _: self.pages.set_visible_child_name('welcome'), True))

        def review(self, _):
            index = self.disk_choice.get_selected()
            if index >= len(self.disks):
                return
            disk = self.disks[index]
            self.summary.set_text('Selected disk: ' + disk_label(disk)
                                  + '\n\nPlanned system: Arch Linux'
                                  + '\nDesktop: Niri / Wayland'
                                  + '\nTerminal: Hafþi'
                                  + '\nBrowser: Google Chrome'
                                  + '\n\nMode: preview only')
            self.pages.set_visible_child_name('review')

        def network(self, _):
            # Configure only the disposable live session; no target disk mounts.
            subprocess.Popen(['foot', '--title=Live network settings', 'nmtui'])

        def restart(self, _):
            subprocess.Popen(['systemctl', 'reboot'])

    Welcome().run([sys.argv[0]])


if __name__ == '__main__':
    main()
